<?xml version="1.0" encoding="UTF-8"?>
<!--
  Throwaway test fixture: metadata for a fictitious IdP used only by the bennu-saml-client
  test suite. The embedded certificate matches keys/idp-key-pkcs8. DO NOT use in production.

  Endpoint order matters to the test suite: the first SingleSignOnService (Redirect) and the
  first SingleLogoutService (Redirect) are the ones Spring Security resolves from this metadata,
  and WantAuthnRequestsSigned makes the engine sign the redirect-bound AuthnRequest.
-->
<EntityDescriptor xmlns="urn:oasis:names:tc:SAML:2.0:metadata"
                  entityID="https://idp.test.example/metadata">
  <IDPSSODescriptor WantAuthnRequestsSigned="true"
                    protocolSupportEnumeration="urn:oasis:names:tc:SAML:2.0:protocol">
    <KeyDescriptor use="signing">
      <ds:KeyInfo xmlns:ds="http://www.w3.org/2000/09/xmldsig#">
        <ds:X509Data>
          <ds:X509Certificate></ds:X509Certificate>
        </ds:X509Data>
      </ds:KeyInfo>
    </KeyDescriptor>
    <NameIDFormat>urn:oasis:names:tc:SAML:2.0:nameid-format:persistent</NameIDFormat>
    <SingleSignOnService Binding="urn:oasis:names:tc:SAML:2.0:bindings:HTTP-Redirect"
                         Location="https://idp.test.example/sso/redirect"/>
    <SingleSignOnService Binding="urn:oasis:names:tc:SAML:2.0:bindings:HTTP-POST"
                         Location="https://idp.test.example/sso/post"/>
    <SingleLogoutService Binding="urn:oasis:names:tc:SAML:2.0:bindings:HTTP-Redirect"
                         Location="https://idp.test.example/slo/redirect"/>
    <SingleLogoutService Binding="urn:oasis:names:tc:SAML:2.0:bindings:HTTP-POST"
                         Location="https://idp.test.example/slo/post"/>
  </IDPSSODescriptor>
</EntityDescriptor>
